FRONTEND_ORIGIN=http://localhost:3000

# Optional when the API is mounted under a subdirectory (e.g. /api)
# BASE_PATH=/api

# Optional CSV store location (defaults to server/data/contacts.csv)
# CONTACT_CSV_PATH=/absolute/path/to/contacts.csv

# CoNext Assistant AI — OpenAI-compatible (OpenAI or OpenRouter)
# OpenRouter example:
OPENAI_API_KEY=sk-or-v1-your-openrouter-key
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-4o-mini

# Live support chat (admin panel at /admin/live.php)
LIVE_CHAT_ADMIN_TOKEN=change-this-to-a-long-random-secret

# Auth user store (defaults to server/data/users.json)
# AUTH_DATA_DIR=/absolute/path/to/data
# USERS_JSON_PATH=/absolute/path/to/users.json

# Google Sign-In (OAuth client ID from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# OpenAI direct example:
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
